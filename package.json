{
  "name": "birdleague",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @birdleague/api --filter @birdleague/web dev",
    "dev:web": "pnpm --filter @birdleague/web dev",
    "dev:api": "pnpm --filter @birdleague/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @birdleague/api prisma:generate",
    "db:migrate": "pnpm --filter @birdleague/api prisma:migrate",
    "db:seed": "pnpm --filter @birdleague/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "argon2", "esbuild", "prisma", "sharp"]
  }
}
